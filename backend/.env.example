# ---- Backend environment variables (copy to backend/.env for local dev) ----
# On Render, set these in the service's "Environment" tab instead of a file.

# Supabase (required — backend crashes without these)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Razorpay — use rzp_test_... keys for test mode, rzp_live_... when activated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Translation (optional — falls back to Google Translate if unset)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# AI image generation (optional — only if you use the Cloudflare image feature)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Deployed frontend URL(s) for CORS, comma-separated (add after Vercel deploy)
# e.g. https://digiinvite.vercel.app
FRONTEND_ORIGINS=
